{
  "permissions": {
    "deny": [
      "Edit(**/*.test.ts)",
      "Edit(**/*.test.tsx)",
      "Edit(**/*.spec.ts)",
      "Edit(**/*.spec.tsx)",
      "Edit(/e2e/**)",
      "Edit(/docs/milestones/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(**/vitest.config.*)",
      "Edit(**/playwright.config.*)",
      "Edit(**/*.setup.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-acceptance.sh"
          }
        ]
      }
    ]
  }
}
